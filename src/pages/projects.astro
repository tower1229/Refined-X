---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import { breadcrumbJsonLd, collectionPageJsonLd, getPublicProfile } from '../lib/public-data';
import { SITE_BRAND, SITE_PERSONA, UI } from '../lib/site-copy';
import { siteConfig } from '../../site.config.mjs';

const COURSE_CABINET_SIZE = 3;

const publicProfile = await getPublicProfile();
const allProjects = (await getCollection('projects')).sort((a, b) =>
  (a.data.sortRank - b.data.sortRank) || a.data.title.localeCompare(b.data.title, siteConfig.locale),
);

const projects = allProjects.filter(p => p.data.category === 'project' || !p.data.category);
const courses = allProjects.filter(p => p.data.category === 'course');
const snippets = allProjects.filter(p => p.data.category === 'snippet');
const featuredProjects = projects.filter(p => p.data.featured);
const projectIndex = projects.filter(p => !p.data.featured);
const courseSlots = Array.from({ length: COURSE_CABINET_SIZE }, (_, index) => courses[index] ?? null);
const heroStats = publicProfile.stats;
const copy = siteConfig.brand.projects;

const statusLabels = {
  active: 'Active',
  maintained: 'Maintained',
  archived: 'Archived',
  planned: 'Planned',
  unknown: 'Project',
};

const projectsDescription = copy.description;
const structuredData = [
  collectionPageJsonLd({
    path: '/projects/',
    name: copy.heading,
    description: projectsDescription,
    items: allProjects.map(({ data }) => ({
      name: data.title,
      url: data.url ?? data.repository ?? '/projects/',
    })),
  }),
  breadcrumbJsonLd([
    { name: UI.common.home, path: '/' },
    { name: copy.heading, path: '/projects/' },
  ]),
];
---

<StarlightPage
  frontmatter={{
    title: `${copy.titleSuffix}｜${SITE_BRAND}`,
    description: projectsDescription,
    template: 'splash',
    contentType: 'page',
    slug: 'projects',
    llmSummary: `Public projects and experiments by ${SITE_PERSONA}.`,
  }}
>
  {structuredData.map((value) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(value)} />
  ))}
  <div class="wrap page projects-wrap">
    <div class="projects-page">
      <section class="projects-hero" aria-labelledby="_top">
        <div class="crumbs projects-crumbs"><a href="/">{UI.common.home}</a><span class="sep">/</span><span>{copy.heading}</span></div>
        <div class="projects-hero-copy">
          <h1 id="_top" class="display projects-heading">{copy.heading}</h1>
          <p class="lede projects-lede">
            {copy.lede}
          </p>
          <div class="projects-hero-actions">
            <a class="btn btn-solid" href="/about/">{UI.nav.about}</a>
            {publicProfile.github && (
              <a class="btn btn-ghost" href={publicProfile.github} target="_blank" rel="noreferrer">GitHub</a>
            )}
          </div>
        </div>
        {heroStats.length > 0 && (
          <dl class="projects-stats" aria-label={UI.projects.highlightsAria}>
            {heroStats.map((item) => (
              <div class="projects-stat">
                <dt>{item.value}</dt>
                <dd>{item.label}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    </div>

    <section class="projects-showcase" aria-labelledby="featured-projects">
      <div class="section-head section-head-large projects-section-head">
        <div>
          <p class="eyebrow">Featured</p>
          <h2 id="featured-projects" class="section-title">{UI.projects.featuredHeading}</h2>
        </div>
      </div>
      <div class="project-feature-grid">
        {featuredProjects.map(({ data }, index) => {
          const link = data.url || data.repository || '#';
          const isExternal = link !== '#' && !link.startsWith('/');
          return (
            <a class={`project-feature-card project-feature-card-${index % 3}`} href={link} target={isExternal ? "_blank" : undefined} rel={isExternal ? 'noreferrer' : undefined}>
              <div class="project-feature-media">
                {data.image ? (
                  <img src={data.image} alt={data.imageAlt ?? UI.projects.projectShotAlt(data.title)} loading={index < 2 ? 'eager' : 'lazy'} />
                ) : (
                  <div class="project-feature-placeholder">{data.title.slice(0, 2)}</div>
                )}
              </div>
              <div class="project-feature-body">
                <div class="project-feature-topline">
                  <span>{statusLabels[data.status]}</span>
                  {data.role && <span>{data.role}</span>}
                </div>
                <h3 class="project-feature-title">{data.title}</h3>
                <p class="project-feature-desc">{data.description}</p>
                {data.impact && <p class="project-feature-impact">{data.impact}</p>}
                {data.proofPoints.length > 0 && (
                  <ul class="project-proof-list" aria-label={UI.projects.proofAria(data.title)}>
                    {data.proofPoints.map((point) => <li>{point}</li>)}
                  </ul>
                )}
                <div class="project-feature-foot">
                  <span class="project-tags">{data.tags.slice(0, 3).join(' / ')}</span>
                  <span class="project-open">{UI.projects.viewProject} {isExternal && <Icon name="external" size={14} class="muted-icon" />}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    {courses.length > 0 && (
      <section class="course-gallery" aria-labelledby="course-gallery-title">
        <div class="course-gallery-head">
          <p class="eyebrow">Open Courses</p>
          <h2 id="course-gallery-title" class="section-title">{UI.projects.coursesHeading}</h2>
        </div>
        <div class="course-cabinet" aria-label={UI.projects.coursesAria}>
          {courseSlots.map((course, index) => {
            if (!course) {
              return (
                <div class="course-exhibit course-exhibit-empty" aria-label={UI.projects.courseEmptyAria}>
                  <div class="course-object course-object-full">
                    <img src="/projects/courses/next-course-cover.png" alt={UI.projects.courseCoverAlt} loading="lazy" />
                  </div>
                  <div class="course-plaque">
                    <span>{UI.projects.slot(index + 1)}</span>
                    <strong>{UI.projects.nextCourse}</strong>
                    <p>{UI.projects.notYetPublic}</p>
                  </div>
                </div>
              );
            }

            const data = course.data;
            const link = data.url || data.repository || '#';
            const isExternal = link !== '#' && !link.startsWith('/');
            return (
              <a class="course-exhibit" href={link} target={isExternal ? "_blank" : undefined} rel={isExternal ? 'noreferrer' : undefined}>
                <div class="course-object course-object-case">
                  <div class="course-display-content">
                    {data.image ? (
                      <img src={data.image} alt={data.imageAlt ?? UI.projects.courseCoverAltTitle(data.title)} loading={index === 0 ? 'eager' : 'lazy'} />
                    ) : (
                      <div class="course-object-title">{data.title}</div>
                    )}
                  </div>
                </div>
                <div class="course-plaque">
                  <span>{data.role ?? UI.projects.courseAuthorFallback}</span>
                  <strong>{data.title}</strong>
                  <p>{data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="projects-index" aria-labelledby="project-index">
      <div class="section-head section-head-large projects-section-head">
        <div>
          <p class="eyebrow">Archive</p>
          <h2 id="project-index" class="section-title">{UI.projects.moreHeading}</h2>
        </div>
      </div>
      <div class="project-compact-list">
      {projectIndex.map(({ data }) => {
        const link = data.url || data.repository || '#';
        const isExternal = link !== '#' && !link.startsWith('/');
        return (
          <a class="proj project-compact" href={link} target={isExternal ? "_blank" : undefined} rel={isExternal ? 'noreferrer' : undefined}>
            <div class="proj-name">{data.title}</div>
            <div class="proj-desc">{data.description}</div>
            <div class="proj-star">
              {data.status === 'active' || data.status === 'maintained' ? (
                <span class="project-status"><Icon name="star" size={13} /> {UI.projects.maintaining}</span>
              ) : ''}
            </div>
            {isExternal && <Icon name="external" size={16} class="muted-icon" />}
          </a>
        );
      })}
      </div>
    </section>

    {snippets.length > 0 && (
      <section class="projects-index" aria-labelledby="snippet-index">
        <div class="section-head section-head-large">
          <h2 id="snippet-index" class="section-title section-title-small">{UI.projects.snippetsHeading}</h2>
        </div>
        <div class="project-compact-list">
          {snippets.map(({ data }) => {
            const link = data.url || data.repository || '#';
            const isExternal = link !== '#' && !link.startsWith('/');
            return (
              <a class="proj project-compact" href={link} target={isExternal ? "_blank" : undefined} rel={isExternal ? 'noreferrer' : undefined}>
                <div class="proj-name">{data.title}</div>
                <div class="proj-desc">{data.description}</div>
                <div class="proj-star">
                  {data.status === 'active' || data.status === 'maintained' ? (
                    <span class="project-status"><Icon name="star" size={13} /> {UI.projects.maintaining}</span>
                  ) : ''}
                </div>
                {isExternal && <Icon name="external" size={16} class="muted-icon" />}
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</StarlightPage>
