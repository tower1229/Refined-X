---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { UI } from '../../lib/site-copy';
import { breadcrumbJsonLd, collectionPageJsonLd, getTopics } from '../../lib/public-data';

const topics = await getTopics();
const topicsDescription = UI.topics.indexDescription;
const structuredData = [
  collectionPageJsonLd({
    path: '/topics/',
    name: UI.topics.allHeading,
    description: topicsDescription,
    items: topics.map((topic) => ({ name: topic.name, url: `/topics/${topic.slug}/` })),
  }),
  breadcrumbJsonLd([
    { name: UI.topics.homeCrumb, path: '/' },
    { name: UI.topics.directory, path: '/topics/' },
  ]),
];
topics.sort((a, b) => b.articles.length - a.articles.length);
---

<StarlightPage
  frontmatter={{
    title: UI.topics.label,
    description: topicsDescription,
    template: 'splash',
    contentType: 'page',
    slug: 'topics',
    llmSummary: topicsDescription,
  }}
>
  {structuredData.map((value) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(value)} />
  ))}
  <div class="wrap page">
    <div class="crumbs"><a href="/">{UI.topics.homeCrumb}</a><span class="sep">/</span><span>{UI.topics.directory}</span></div>
    <h1 id="_top" class="display page-heading">{UI.topics.allHeading}</h1>
    <p class="lede page-lede">{UI.topics.indexLede}</p>
    
    <div class="tagrow topic-cloud">
      {topics.map(topic => (
        <a href={`/topics/${topic.slug}/`} class="tag topic-tag">
          {topic.name} <span class="topic-count">{topic.articles.length}</span>
        </a>
      ))}
    </div>
  </div>
</StarlightPage>
