---
import { SITE_LOCALE, SITE_BRAND, UI } from '../lib/site-copy';
import { absoluteUrl, breadcrumbJsonLd, getPublicProfile, personJsonLd } from '../lib/public-data';
import { sitePath, stripBase, withBase } from '../lib/paths';
import { seriesName } from '../lib/articles';
import { optimizedAssetUrl } from '../lib/assets.mjs';
import { DEFAULT_SEO_IMAGE, normalizeSeoHead, type SeoHeadTag } from '../lib/seo';

const { entry, head } = Astro.locals.starlightRoute;
const logicalPath = stripBase(Astro.url.pathname);
const isHome = logicalPath === '/' || logicalPath === '';
const contentType = entry.data.contentType;
const structuredData: Record<string, unknown>[] = [];
const normalizedHead = normalizeSeoHead({ head, entry, pathname: Astro.url.pathname });

if (contentType === 'article') {
	const profile = await getPublicProfile();
	const articleUrl = absoluteUrl(sitePath(`/${entry.id}`));
	const breadcrumbItems = [
		{ name: UI.common.home, item: absoluteUrl('/') },
		{ name: UI.nav.writing, item: absoluteUrl('/writing/') },
	];
	if (entry.data.series) {
		breadcrumbItems.push({
			name: seriesName(entry.data.series),
			item: absoluteUrl(`/writing/${entry.data.series}/`),
		});
	}
	breadcrumbItems.push({ name: entry.data.title, item: articleUrl });

	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		'@id': `${articleUrl}#article`,
		mainEntityOfPage: articleUrl,
		headline: entry.data.title,
		description: entry.data.description,
		image: absoluteUrl(optimizedAssetUrl(entry.data.seoImage ?? DEFAULT_SEO_IMAGE)),
		datePublished: entry.data.pubDate?.toISOString(),
		dateModified: entry.data.updatedDate?.toISOString() ?? entry.data.pubDate?.toISOString(),
		author: personJsonLd(profile),
		publisher: { '@id': profile.id },
		keywords: entry.data.tags,
		articleSection: entry.data.series,
		inLanguage: SITE_LOCALE,
		isPartOf: { '@id': absoluteUrl('/#website') },
	});
	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumbItems.map((item, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			...item,
		})),
	});
} else if (contentType === 'answer') {
	const answerUrl = sitePath(`/${entry.id}`);
	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': absoluteUrl(`${answerUrl}#faq`),
		mainEntity: [
			{
				'@type': 'Question',
				name: entry.data.question,
				acceptedAnswer: { '@type': 'Answer', text: entry.data.shortAnswer },
			},
		],
	});
	structuredData.push(
		breadcrumbJsonLd([
			{ name: UI.common.home, path: '/' },
			{ name: UI.answers.label, path: '/answers/' },
			{ name: entry.data.question ?? entry.data.title, path: answerUrl },
		]),
	);
}
---

<script is:inline>
	(() => {
		const preferenceKey = 'refined-x-theme-preference';
		const starlightKey = 'starlight-theme';
		const root = document.documentElement;
		const getStored = (key) => {
			try {
				return localStorage.getItem(key);
			} catch {
				return null;
			}
		};
		const setStored = (key, value) => {
			try {
				localStorage.setItem(key, value);
			} catch {
				// Storage can be unavailable; still apply the page theme.
			}
		};
		const storedPreference = getStored(preferenceKey);
		const legacyTheme = getStored(starlightKey);
		const preference =
			storedPreference === 'auto' || storedPreference === 'light' || storedPreference === 'dark'
				? storedPreference
				: storedPreference === null && (legacyTheme === 'light' || legacyTheme === 'dark')
					? legacyTheme
					: 'auto';
		const hour = new Date().getHours();
		const resolvedTheme = preference === 'light' || preference === 'dark' ? preference : hour >= 6 && hour < 18 ? 'light' : 'dark';
		root.dataset.theme = resolvedTheme;
		root.dataset.themePreference = preference;
		root.style.colorScheme = resolvedTheme;
		setStored(preferenceKey, preference);
		setStored(starlightKey, resolvedTheme);
	})();
</script>
{normalizedHead.map(({ tag: Tag, attrs, content }: SeoHeadTag) => <Tag {...attrs} set:html={content} />)}
<link rel="alternate" type="application/rss+xml" title={SITE_BRAND} href={absoluteUrl('/rss.xml')} />
{isHome && (
 <script is:inline define:vars={{ lightHero: withBase(optimizedAssetUrl('/asset/hero-light.png')), darkHero: withBase(optimizedAssetUrl('/asset/hero-dark.png')), lightHeroSmall: withBase(optimizedAssetUrl('/asset/hero-light.png', 960)), darkHeroSmall: withBase(optimizedAssetUrl('/asset/hero-dark.png', 960)) }}>
  const isDark = document.documentElement.dataset.theme === 'dark';
  const desktopHero = isDark ? darkHero : lightHero;
  const smallHero = isDark ? darkHeroSmall : lightHeroSmall;
  const preload = document.createElement('link');
  preload.rel = 'preload';
  preload.as = 'image';
  preload.href = window.matchMedia('(max-width: 720px)').matches ? smallHero : desktopHero;
  preload.fetchPriority = 'high';
  document.head.append(preload);
 </script>
)}
{structuredData.map((value) => (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(value)} />
))}
