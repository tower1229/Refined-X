---
import type { CollectionEntry } from 'astro:content';
import { formatArticleDate, seriesName } from '../lib/articles';

interface Props {
	articles: CollectionEntry<'docs'>[];
	showSeries?: boolean;
}

const { articles, showSeries = true } = Astro.props;
---

<div class="feed">
	{
		articles.map((a) => (
			<a class="entry" href={`/${a.id}/`}>
				<div class="entry-date">{formatArticleDate(a.data.pubDate!)}</div>
				<div class="entry-main">
					<div class="entry-title">{a.data.title || a.id}</div>
					<div class="entry-excerpt">{a.data.llmSummary || a.data.description || ''}</div>
				</div>
				{showSeries && a.data.series && <div class="entry-pillar">{seriesName(a.data.series)}</div>}
			</a>
		))
	}
</div>
